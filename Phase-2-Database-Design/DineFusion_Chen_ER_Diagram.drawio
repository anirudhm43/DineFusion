try"/></mxCell><mxCell id="v140" value="attached to its diamond" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1155" y="4282" width="240" height="26" as="geometry"/></mxCell><mxCell id="e141" value="" style="endArrow=none;html=1;strokeColor=#2b2b2b;strokeWidth=2.4;shape=link;width=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="4243" as="sourcePoint"/><mxPoint x="1600" y="4243" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v142" value="double line = TOTAL participation (mandatory)" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1360" y="4270" width="340" height="26" as="geometry"/></mxCell><mxCell id="e143" value="" style="endArrow=none;html=1;strokeColor=#2b2b2b;strokeWidth=2.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1720" y="4243" as="sourcePoint"/><mxPoint x="1860" y="4243" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v144" value="single line = PARTIAL participation (optional)" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1610" y="4270" width="360" height="26" as="geometry"/></mxCell><mxCell id="v145" value="1   N   M" style="text;html=1;align=center;fontStyle=1;fontSize=20;fontColor=#b00020;" vertex="1" parent="1"><mxGeometry x="1990" y="4222" width="160" height="30" as="geometry"/></mxCell><mxCell id="v146" value="red letter = cardinality of the entity" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1920" y="4266" width="300" height="26" as="geometry"/></mxCell><mxCell id="v147" value="at that end of the relationship" style="text;html=1;align=center;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1920" y="4290" width="300" height="26" as="geometry"/></mxCell><mxCell id="v148" value="1:N" style="text;html=1;align=center;verticalAlign=middle;fontStyle=2;fontSize=15;fontColor=#7a5a00;" vertex="1" parent="1"><mxGeometry x="2280" y="4222"